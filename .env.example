# KAVACH local runtime overrides

# demo: synthetic audio stream, safest default for local demos
# mic: live microphone stream with automatic fallback to demo if unavailable
KAVACH_AUDIO_SOURCE=demo

# Runtime logging
KAVACH_LOG_LEVEL=INFO
KAVACH_LOG_DIR=logs
KAVACH_MURIL_ENABLED=false

# Security
# `none` is acceptable for local demo only. For pilot/prod use `api_key` or `bearer`.
KAVACH_AUTH_MODE=none
KAVACH_API_KEY=
KAVACH_BEARER_TOKEN=
KAVACH_RATE_LIMIT_PER_MINUTE=120
KAVACH_ALLOW_DEMO_CONTROLS=true
KAVACH_CORS_ORIGINS=http://localhost:3000,http://localhost:5175,http://127.0.0.1:3000,http://127.0.0.1:5175

# Optional caller-supplied request correlation id header is x-request-id
